# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên git

# Server
SERVER_PORT=8080

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/medical
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# JWT Secret Key (base64, tối thiểu 32 ký tự)
APP_KEY=your-secret-key-here-replace-with-strong-random-value

# Mail (Gmail App Password)
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password

# OCR Service
OCR_API_URL=http://localhost:8000

# App
APP_DEBUG=true
APP_SERVER_URL=http://localhost:8080
APP_UPLOAD_DIR=uploads/photos

# JPA (dev default: update | prod: validate)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
