# Copy this file to .env and fill real values.
# Do not commit .env to git.

# Server
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Database
# Local development outside Docker:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/medical
# Docker Compose overrides this to jdbc:postgresql://db:5432/medical.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/medical
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# JWT secret key
APP_KEY=replace-with-strong-random-value

# Mail (Gmail app password)
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password
MAIL_DEBUG=false

# OCR service
OCR_API_URL=https://model.medicalocr-nthoa.io.vn

# Encryption
ENCRYPTION_SECRET_KEY=replace-with-strong-random-value

# App
APP_DEBUG=false
APP_SERVER_URL=https://api.medicalocr-nthoa.io.vn
APP_UPLOAD_DIR=/app/uploads/photos

# JPA
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_BUCKET_NAME=medicaler-image
